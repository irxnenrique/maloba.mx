{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@app/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@data/*": ["src/data/*"],
      "@hooks/*": ["src/hooks/*"],
      "@i18n/*": ["src/i18n/*"],
      "@app-types/*": ["src/types/*"],
      "@admin-page": ["src/pages/admin-page/index.ts"],
      "@admin-page/*": ["src/pages/admin-page/*"],
      "@home-page": ["src/pages/home-page/index.ts"],
      "@home-page/*": ["src/pages/home-page/*"],
      "@not-found-page": ["src/pages/not-found-page/index.ts"],
      "@not-found-page/*": ["src/pages/not-found-page/*"],
      "@project-page": ["src/pages/project-page/index.ts"],
      "@project-page/*": ["src/pages/project-page/*"],
      "@projects-archive-page": ["src/pages/projects-archive-page/index.ts"],
      "@projects-archive-page/*": ["src/pages/projects-archive-page/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
